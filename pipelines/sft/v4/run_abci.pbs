#!/bin/bash
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=12:00:00
#PBS -N v4-sft-swallow8b
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
source /etc/profile.d/modules.sh
module load python/3.12/3.12.9
module load cuda/13.0/13.0.1

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run ./setup_abci.sh before qsub."
  exit 1
fi
if [ ! -f data/v4_sft.jsonl ]; then
  echo "Missing data/v4_sft.jsonl. Copy the complete v4 SFT folder again."
  exit 1
fi
source .venv/bin/activate

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="${HF_HOME:-${PBS_O_WORKDIR}/.cache/huggingface}"

mkdir -p logs outputs "${HF_HOME}"
nvidia-smi
python train_v4_sft.py --config config.json --structure-only
python train_v4_sft.py --config config.json --resume auto

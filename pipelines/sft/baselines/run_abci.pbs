#!/bin/bash
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=12:00:00
#PBS -N baseline-sft
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR}"
source /etc/profile.d/modules.sh
module load python/3.12/3.12.9
module load cuda/13.0/13.0.1
source ../v4/.venv/bin/activate
: "${SFT_CONFIG:?Set SFT_CONFIG to an absolute generated config path}"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
python ../v4/train_v4_sft.py --config "${SFT_CONFIG}" --structure-only
python ../v4/train_v4_sft.py --config "${SFT_CONFIG}" --resume auto
